# 백엔드 API 베이스 URL
# 로컬: 비워두면 vite.config.js의 프록시(localhost:8001)를 사용합니다.
# 프로덕션: Render 백엔드 주소를 https:// 로 지정합니다.
VITE_API_URL=
# VITE_API_URL=https://cryptovol-api.onrender.com

# WebSocket 베이스 URL (/ws/ticks 실시간 시세 릴레이)
# 로컬: 비워두면 ws://<현재 호스트> 로 폴백합니다.
# 프로덕션: 반드시 wss:// 를 사용합니다. HTTPS 페이지에서 ws:// 는
#           브라우저가 mixed content로 차단하여 실시간 시세가 조용히 끊깁니다.
VITE_WS_URL=
# VITE_WS_URL=wss://cryptovol-api.onrender.com
