# Database: SQLite (default) or PostgreSQL
DATABASE_URL=sqlite:///./data/crypto.db
# DATABASE_URL=postgresql://cryptovol:cryptovol@localhost:5432/cryptovol
# 프로덕션(Render 무료 플랜)은 persistent disk가 없어 SQLite가 재시작마다 소실된다.
# Neon/Supabase 등 외부 PostgreSQL을 사용할 것.

# 허용할 프론트엔드 오리진 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=https://cryptovol.vercel.app

# Vercel preview 배포는 커밋마다 도메인이 바뀌므로 정규식으로 허용한다 (선택)
CORS_ORIGIN_REGEX=
# CORS_ORIGIN_REGEX=https://cryptovol-.*\.vercel\.app

OPENAI_API_KEY=sk-...    # Optional: for AI briefing feature
